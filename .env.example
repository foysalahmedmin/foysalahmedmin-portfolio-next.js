# =============================================================================
# Server (NODE_ENV is set by Next.js; do not override it in env files)
# =============================================================================
PORT=3000

# =============================================================================
# Application URLs
# =============================================================================
NEXT_PUBLIC_URL=http://localhost:3000
# Server-only URL used in password-reset email messages.
RESET_PASSWORD_UI_LINK=http://localhost:3000/admin/reset-password

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/foysalahmedmin

# =============================================================================
# Auth — Bcrypt
# =============================================================================
BCRYPT_SALT_ROUNDS=12

# One-time, API-free initial bootstrap. Leave these unset after use. The command
# refuses any database that already contains a user or completed marker.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_CONFIRM=CREATE_THE_ONLY_INITIAL_SUPER_ADMIN

# =============================================================================
# Auth — JWT (use distinct long random strings; rotate per environment)
# =============================================================================
JWT_ACCESS_SECRET=replace-with-random-32+chars
JWT_REFRESH_SECRET=replace-with-random-32+chars

# =============================================================================
# Session
# =============================================================================
SESSION_SECRET=replace-with-random-32+chars
AUDIT_HMAC_SECRET=replace-with-a-distinct-random-32+char-secret

# Short-lived, server-only Page preview capability. Keep this distinct from
# session/JWT secrets; previews are cookie-scoped and never placed in URLs.
PAGE_PREVIEW_SECRET=replace-with-a-distinct-random-32+char-secret
PAGE_PREVIEW_TTL_SECONDS=600

# Public account creation is disabled by default. Enabling it only creates the
# unprivileged `user` role; privileged accounts are created by administrators.
AUTH_PUBLIC_SIGNUP_ENABLED=false

# A publicly reachable production admin must use MFA. `required` deliberately
# requires TOTP/recovery verification before an admin session is created. Use
# `disabled` only for local development or a separately protected private admin.
AUTH_ADMIN_MFA_MODE=required
# Distinct encryption key for MFA seeds. Generate at least 32 random bytes and
# encode as canonical base64url. Do not change it while credentials exist:
# ad-hoc replacement makes every enrolled TOTP seed unreadable.
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-distinct-random-32+byte-base64url-key
AUTH_MFA_ISSUER=Foysalahmedmin Portfolio

# Distinct HMAC secret and trusted edge IP policy for distributed auth limits.
AUTH_ABUSE_SECRET=replace-with-a-distinct-random-32+char-secret
AUTH_CLIENT_IP_HEADER=x-forwarded-for
AUTH_TRUSTED_PROXY_HOPS=0

# =============================================================================
# Email (Nodemailer + Gmail SMTP)
# Use a Gmail app password, not your account password.
# https://support.google.com/accounts/answer/185833
# =============================================================================
AUTH_USER_EMAIL=your-email@gmail.com
AUTH_USER_EMAIL_PASSWORD=your-gmail-app-password

# =============================================================================
# Contact intake security, delivery and privacy
# Production contact writes fail closed unless the abuse secret, Upstash REST
# credentials, trusted proxy/IP policy, and transaction-capable MongoDB are set.
# CONTACT_ALLOWED_ORIGINS is a comma-separated exact-origin allowlist.
# Choose an IP header that your edge proxy overwrites; never trust a
# client-preserved forwarding header. Hops are counted from the right of XFF.
# =============================================================================
CONTACT_ALLOWED_ORIGINS=https://your-production-domain.example
CONTACT_ABUSE_SECRET=replace-with-a-distinct-random-32+char-secret
CONTACT_CLIENT_IP_HEADER=x-forwarded-for
CONTACT_TRUSTED_PROXY_HOPS=0
CONTACT_MAX_BODY_BYTES=16384
CONTACT_MIN_FILL_TIME_MS=1500
CONTACT_MAX_FILL_TIME_MS=7200000
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
CONTACT_RETENTION_DAYS=365
CONTACT_REQUIRE_TRANSACTIONS=true

# Upstash REST is the production rate-limit authority. Local/test runs use an
# isolated in-process fallback and never mistake it for production protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Call the internal outbox and retention routes from a trusted scheduler with
# `Authorization: Bearer <CONTACT_WORKER_SECRET>`.
CONTACT_WORKER_SECRET=replace-with-a-distinct-random-32+char-secret
CONTACT_WORKER_BATCH_SIZE=10
CONTACT_WORKER_MAX_ATTEMPTS=5

# =============================================================================
# Cloud Storage Provider
# Supported values: cloudinary | gcp (defaults to cloudinary when omitted)
# Keep credentials configured for every provider that still has files in the DB;
# permanent deletion always uses the provider stored on each file record.
# =============================================================================
STORAGE_PROVIDER=cloudinary

# =============================================================================
# Cloudinary Cloud Storage (required when STORAGE_PROVIDER=cloudinary)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=min

# =============================================================================
# Google Cloud Storage (required when STORAGE_PROVIDER=gcp)
# =============================================================================
GCP_CREDENTIALS_PATH=credentials/gcp.credentials.json
GCP_PROJECT_ID=
# Legacy fallback for old File records without a stored bucket. New records use
# the explicit public/private bucket names below.
GCP_BUCKET_NAME=
GCP_PUBLIC_BUCKET_NAME=
# Required for private media (for example resume PDFs). Must not be public and
# must be different from GCP_PUBLIC_BUCKET_NAME.
GCP_PRIVATE_BUCKET_NAME=

# Upload admission limits are checked before Next buffers multipart bodies.
# Apply an equal or lower limit at the reverse proxy/CDN. Concurrency is per
# application process, so production also needs a gateway-wide concurrency cap.
MEDIA_UPLOAD_MAX_REQUEST_BYTES=67108864
MEDIA_UPLOAD_MAX_CONCURRENCY=3
# High-entropy bearer secret for the scheduled managed-media reconciler.
MEDIA_RECONCILE_SECRET=

# =============================================================================
# Schema migrations (operator-supplied only when running migration commands)
# =============================================================================
MIGRATION_RELEASE=
MIGRATION_LEASE_TTL_MS=
MIGRATION_BACKUP_REFERENCE=
MIGRATION_BACKUP_VERIFIED_AT=
MIGRATION_WRITES_QUIESCED=false

# =============================================================================
# Versioned seed operations
# =============================================================================
# Optional defense-in-depth declaration; when set it must exactly match
# NODE_ENV. If more than one verified super-admin exists, select the existing
# seed actor explicitly. The seed command never creates or changes that account.
SEED_ENVIRONMENT=development
SEED_ACTOR_EMAIL=
# Repository-relative trusted source root; absolute/traversal paths are rejected.
SEED_MEDIA_ASSET_ROOT=seed-assets

# Required only for the corresponding guarded write. Demo and reset commands
# are unconditionally rejected when NODE_ENV=production, regardless of flags.
# Production foundation apply: APPLY_TRUTHFUL_PORTFOLIO_FOUNDATION
# Non-production reset: RESET_NON_PRODUCTION_SEED_DATA
SEED_PRODUCTION_CONFIRM=
SEED_RESET_CONFIRM=

# =============================================================================
# Privacy-safe Web Vitals (disabled by default)
# =============================================================================
# Enable only after production log retention and edge rate limiting are owned.
# Payloads contain coarse route/device classes and no URL, identity or form data.
NEXT_PUBLIC_WEB_VITALS_ENABLED=false
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
NEXT_PUBLIC_RELEASE_ID=local
