# =============================================================================
# SERVER
# =============================================================================
# NODE_ENV is set by Next.js — do not override it here.
PORT=3000

# =============================================================================
# APP URLS
# =============================================================================
NEXT_PUBLIC_URL=http://localhost:3000
# Used in password-reset emails (server-only).
RESET_PASSWORD_UI_LINK=http://localhost:3000/admin/reset-password

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/foysalahmedmin

# =============================================================================
# AUTH — PASSWORD HASHING
# =============================================================================
BCRYPT_SALT_ROUNDS=12

# =============================================================================
# AUTH — BOOTSTRAP SUPER ADMIN
# =============================================================================
# One-time initial admin creation. Clear these values after use.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_CONFIRM=CREATE_THE_ONLY_INITIAL_SUPER_ADMIN

# =============================================================================
# AUTH — JWT
# =============================================================================
# Use distinct random 32+ char secrets per environment.
JWT_ACCESS_SECRET=replace-with-random-32+chars
JWT_REFRESH_SECRET=replace-with-random-32+chars

# =============================================================================
# AUTH — SESSION & AUDIT
# =============================================================================
SESSION_SECRET=replace-with-random-32+chars
AUDIT_HMAC_SECRET=replace-with-random-32+chars

# =============================================================================
# AUTH — PAGE PREVIEW
# =============================================================================
# Short-lived preview access. Keep separate from session/JWT secrets.
PAGE_PREVIEW_SECRET=replace-with-random-32+chars
PAGE_PREVIEW_TTL_SECONDS=600

# =============================================================================
# AUTH — SIGNUP & MFA
# =============================================================================
# Public signup creates only the unprivileged `user` role.
AUTH_PUBLIC_SIGNUP_ENABLED=false
# required | disabled — use `disabled` only for local development.
AUTH_ADMIN_MFA_MODE=required
# Base64url key (32+ bytes). Changing it breaks all enrolled TOTP seeds.
AUTH_MFA_ENCRYPTION_KEY=replace-with-random-32+byte-base64url-key
AUTH_MFA_ISSUER=Foysalahmedmin Portfolio

# =============================================================================
# AUTH — ABUSE PROTECTION
# =============================================================================
# Hops are counted from the right of the IP header.
AUTH_ABUSE_SECRET=replace-with-random-32+chars
AUTH_CLIENT_IP_HEADER=x-forwarded-for
AUTH_TRUSTED_PROXY_HOPS=0

# =============================================================================
# EMAIL (GMAIL SMTP)
# =============================================================================
# Use a Gmail app password, not your account password.
AUTH_USER_EMAIL=your-email@gmail.com
AUTH_USER_EMAIL_PASSWORD=your-gmail-app-password

# =============================================================================
# CONTACT — INTAKE
# =============================================================================
# Comma-separated exact origins.
CONTACT_ALLOWED_ORIGINS=https://your-production-domain.example
CONTACT_ABUSE_SECRET=replace-with-random-32+chars
# Use an IP header your edge proxy overwrites.
CONTACT_CLIENT_IP_HEADER=x-forwarded-for
CONTACT_TRUSTED_PROXY_HOPS=0
CONTACT_MAX_BODY_BYTES=16384
CONTACT_MIN_FILL_TIME_MS=1500
CONTACT_MAX_FILL_TIME_MS=7200000
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
CONTACT_RETENTION_DAYS=365
# Requires a transaction-capable MongoDB.
CONTACT_REQUIRE_TRANSACTIONS=true

# =============================================================================
# CONTACT — RATE LIMIT STORE (UPSTASH)
# =============================================================================
# Optional. When set it is the shared rate-limit authority across instances;
# otherwise limits are counted per process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# CONTACT — WORKER
# =============================================================================
# Scheduler calls outbox/retention routes with `Authorization: Bearer <secret>`.
CONTACT_WORKER_SECRET=replace-with-random-32+chars
CONTACT_WORKER_BATCH_SIZE=10
CONTACT_WORKER_MAX_ATTEMPTS=5

# =============================================================================
# STORAGE — PROVIDER
# =============================================================================
# cloudinary | gcp — keep credentials for every provider that still has files.
STORAGE_PROVIDER=cloudinary

# =============================================================================
# STORAGE — CLOUDINARY (when STORAGE_PROVIDER=cloudinary)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=min

# =============================================================================
# STORAGE — GOOGLE CLOUD (when STORAGE_PROVIDER=gcp)
# =============================================================================
GCP_CREDENTIALS_PATH=credentials/gcp.credentials.json
GCP_PROJECT_ID=
# Legacy fallback for old File records without a stored bucket.
GCP_BUCKET_NAME=
GCP_PUBLIC_BUCKET_NAME=
# Must be private and different from the public bucket.
GCP_PRIVATE_BUCKET_NAME=

# =============================================================================
# STORAGE — UPLOADS
# =============================================================================
# Apply an equal or lower limit at the proxy/CDN. Concurrency is per process.
MEDIA_UPLOAD_MAX_REQUEST_BYTES=67108864
MEDIA_UPLOAD_MAX_CONCURRENCY=3
# Bearer secret for the scheduled media reconciler.
MEDIA_RECONCILE_SECRET=

# =============================================================================
# MIGRATIONS
# =============================================================================
# Set only when running migration commands.
MIGRATION_RELEASE=
MIGRATION_LEASE_TTL_MS=
MIGRATION_BACKUP_REFERENCE=
MIGRATION_BACKUP_VERIFIED_AT=
MIGRATION_WRITES_QUIESCED=false

# =============================================================================
# SEEDING
# =============================================================================
# When set, must match NODE_ENV.
SEED_ENVIRONMENT=development
# Existing super-admin used as seed actor; never created or changed by seeding.
SEED_ACTOR_EMAIL=
# Repository-relative path; absolute/traversal paths are rejected.
SEED_MEDIA_ASSET_ROOT=seed-assets
# Confirmations for guarded writes; both are rejected when NODE_ENV=production.
# Foundation apply: APPLY_TRUTHFUL_PORTFOLIO_FOUNDATION
# Non-production reset: RESET_NON_PRODUCTION_SEED_DATA
SEED_PRODUCTION_CONFIRM=
SEED_RESET_CONFIRM=

# =============================================================================
# WEB VITALS
# =============================================================================
# Payloads carry coarse route/device classes only — no URL, identity or form data.
NEXT_PUBLIC_WEB_VITALS_ENABLED=false
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
NEXT_PUBLIC_RELEASE_ID=local
