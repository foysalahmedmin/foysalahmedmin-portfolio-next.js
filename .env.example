# =============================================================================
# Server
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# Public URLs (exposed to browser — must start with NEXT_PUBLIC_)
# =============================================================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_RESET_PASSWORD_UI_LINK=http://localhost:3000/auth/reset-password
NEXT_PUBLIC_EMAIL_VERIFICATION_UI_LINK=http://localhost:3000/auth/verify-email

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/foysalahmedmin

# =============================================================================
# Auth — Bcrypt
# =============================================================================
BCRYPT_SALT_ROUNDS=10
DEFAULT_PASSWORD=ChangeMe123

# =============================================================================
# Auth — JWT (use long random strings; rotate per environment)
# =============================================================================
JWT_ACCESS_SECRET=replace-with-random-32+chars
JWT_ACCESS_SECRET_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-random-32+chars
JWT_REFRESH_SECRET_EXPIRES_IN=7d

JWT_RESET_PASSWORD_SECRET=replace-with-random-32+chars
JWT_RESET_PASSWORD_SECRET_EXPIRES_IN=15m

JWT_EMAIL_VERIFICATION_SECRET=replace-with-random-32+chars
JWT_EMAIL_VERIFICATION_SECRET_EXPIRES_IN=1d

# =============================================================================
# Session
# =============================================================================
SESSION_SECRET=replace-with-random-32+chars

# =============================================================================
# Email (Nodemailer + Gmail SMTP)
# Use a Gmail app password, not your account password.
# https://support.google.com/accounts/answer/185833
# =============================================================================
AUTH_USER_EMAIL=your-email@gmail.com
AUTH_USER_EMAIL_PASSWORD=your-gmail-app-password

# =============================================================================
# Google Cloud Storage (optional — only needed for /api/files/cloud uploads)
# =============================================================================
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=./gcp-credentials.json
GCP_BUCKET_NAME=
