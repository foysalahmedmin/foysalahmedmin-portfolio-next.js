      "C2": { "name": "Workspace list", "template": "ConsoleList" },
      "C3": { "name": "Editor", "template": "ConsoleEditor" },
      "C4": { "name": "Inbox", "template": "ConsoleInbox" },
      "C5": { "name": "Settings", "template": "ConsoleSettings" },
      "C6": { "name": "Auth", "template": "ConsoleAuth" }
    }
